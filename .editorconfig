root = true

[*]
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 80

[*.{c,h]}
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 2

[*.{1, md}]
max_line_length = unset

[*.{yaml, nix}]
indent_style = space
indent_size = 2
